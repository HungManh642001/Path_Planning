// Hợp đồng dữ liệu của service lập kế hoạch đường bay VTX.
//
// Toạ độ: MÉT trên mặt phẳng Oxy, +y là bắc, +x là đông.
// Góc: ĐỘ, phương vị thật, thuận chiều kim đồng hồ từ chính bắc.
//
// Giá trị PlanStatus khớp chính xác service/vtx_service/messages.py.
// Không có trường frame: chỉ có một hệ toạ độ. Không có map_bounds: safezones
// biểu diễn được đúng vùng đó và không phụ thuộc vào vị trí gốc toạ độ.
//
// budget.time_budget_s ĐƯỢC tôn trọng (từ idl_version 2): nó đi thẳng vào
// thuật toán làm điều kiện dừng DUY NHẤT. <= 0 nghĩa là "không đề nghị gì" và
// service dùng mặc định của mình; giá trị quá lớn bị kẹp xuống trần của
// service. Reply luôn mang applied_time_budget_s là giá trị THẬT đã dùng, nên
// client biết đề nghị của mình được nhận hay bị thay.
//
// max_iterations ĐÃ BỊ BỎ khỏi cả SearchBudget lẫn SearchStats (idl_version
// 2): thuật toán không còn trần theo số vòng lặp nào. Một con số vòng lặp
// không phải đại lượng người vận hành suy luận được, và hai điều kiện dừng độc
// lập khiến một lần search có thể kết thúc vì lý do mà reply không hề nói ra.
//
// PLAN_BUSY: giá trị RESERVED, không có đường mã nào sinh ra nó. Service phục
// vụ tuần tự trên một reader KEEP_ALL; một request đến khi đang bận được DDS
// (RELIABLE + KEEP_ALL) XẾP HÀNG và trả lời sau, KHÔNG bị từ chối - xem mục 3
// và 6 của spec thiết kế. Giữ nguyên giá trị số (8) vì đây là hợp đồng trên
// dây: bỏ nó sẽ đánh số lại mọi giá trị đứng sau.
//
// status trong VtxPathPlanReply bên dưới là kiểu PlanStatus (enum) trên dây -
// đây là nguồn sự thật. Binding Python (service/vtx_service/transport.py)
// biểu diễn trường này là uint32 thay vì msg.PlanStatus, vì cyclonedds chỉ
// chấp nhận enum kiểu cyclonedds.idl.IdlEnum làm trường IdlStruct, và gắn kiểu
// đó cho msg.PlanStatus sẽ kéo binding DDS vào messages.py (module đó bị cấm
// import DDS). Giá trị số vẫn phải khớp CHÍNH XÁC enum này - đó là điều
// test_idl_status_enum_matches_python_exactly kiểm tra.

module vtx { module planning {

enum PlanStatus { PLAN_OK, PLAN_NO_PATH, PLAN_START_LEG_BLOCKED,
                  PLAN_GOAL_LEG_BLOCKED, PLAN_ORACLE_REJECTED,
                  PLAN_INVALID_REQUEST, PLAN_TIMEOUT, PLAN_INTERNAL_ERROR,
                  PLAN_BUSY };  // reserved, xem ghi chú ở đầu file

struct Point2D  { double x; double y; };
struct Polygon  { sequence<Point2D> vertices; };   // vành mở
struct Circle   { Point2D center; double radius_m; };

struct VehicleLimits {
  double turn_radius_m;
  double l0_m;
  double dss_m;
  double safe_margin_m;
  double alpha_max_deg;
};

struct SearchBudget {
  double time_budget_s;   // <= 0 => dùng mặc định của service
};

struct VtxPathPlanRequest {
  @key octet          request_id[16];
  unsigned long       idl_version;
  Point2D             start;
  double              start_heading_deg;
  Point2D             goal;
  double              goal_heading_deg;
  boolean             goal_heading_free;
  sequence<Polygon>   islands;
  sequence<Circle>    dynamic_obstacles;
  sequence<Polygon>   safezones;
  boolean             use_preloaded_map;
  VehicleLimits       limits;
  SearchBudget        budget;
};

struct Waypoint { Point2D position; double heading_deg; };

struct SearchStats {
  unsigned long iterations;
  unsigned long open_set_size;
  boolean       search_failed;
  boolean       budget_bound;
};

struct VtxPathPlanReply {
  @key octet          request_id[16];
  unsigned long       idl_version;
  PlanStatus          status;         // uint32 phía Python, xem ghi chú ở đầu file
  string              detail;
  sequence<Waypoint>  waypoints;      // đường bay đầy đủ O..T
  double              path_length_m;
  double              plan_wall_time_s;
  double              applied_time_budget_s;
  SearchStats         stats;
  string              planner_version;
  string              config_hash;
};

}; };
