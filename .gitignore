# ---- Generated output (regenerable, never committed) ----
results*/
logs/
Screenshot/
compare_results*
cases/
# A/B baselines: rebuilt in minutes by scripts/ab_planners.py.
docs/benchmarks/

# ---- Tool caches ----
.superpowers/
.pytest_cache/
.ruff_cache/
.codegraph/
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- Scratch tests ----
# `*_test.py` is the committed convention and IS tracked; `test_*.py` is the
# throwaway prefix. `/tests/` used to be ignored wholesale, which left a third
# of the suite untracked and invisible in a fresh clone.
test_*.py
